<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup on Android 11 and lower (Android 12+ reads data_extraction_rules.xml).
   Everything is backed up, so the list and ticked films survive a new phone,
   except the user's own TMDB API key, which stays on this device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="own_tmdb_key.xml" />
</full-backup-content>
