<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer on Android 12+. Everything is included, so the
   list and ticked films survive a new phone, except the user's own TMDB API
   key, which stays on this device. Keep in step with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="own_tmdb_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="own_tmdb_key.xml" />
    </device-transfer>
</data-extraction-rules>
